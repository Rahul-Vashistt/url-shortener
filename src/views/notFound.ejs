<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Page Not Found | URL Shortener</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
        }

        .not-found-container {
            width: 100%;
            max-width: 500px;
            padding: 45px 35px;
            text-align: center;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        }

        .error-code {
            margin-bottom: 10px;
            font-size: 72px;
            font-weight: 700;
            color: #3498db;
        }

        h1 {
            margin-bottom: 12px;
            font-size: 28px;
        }

        p {
            margin-bottom: 28px;
            line-height: 1.6;
            color: #666;
        }

        .home-btn {
            display: inline-block;
            padding: 12px 22px;
            border-radius: 8px;
            background: #222;
            color: #fff;
            text-decoration: none;
            transition: opacity 0.2s ease;
        }

        .home-btn:hover {
            opacity: 0.85;
        }
    </style>
</head>

<body>

    <main class="not-found-container">

        <div class="error-code">
            404
        </div>

        <% if (typeof shortId !== "undefined" && shortId) { %>

            <h1>Short URL Not Found</h1>

            <p>
                The short URL
                <strong>/<%= shortId %></strong>
                doesn't exist or may have been removed.
            </p>

        <% } else { %>

            <h1>Page Not Found</h1>

            <p>
                The page you're looking for doesn't exist
                or may have been moved.
            </p>

        <% } %>

        <a href="/" class="home-btn">
            Go back home
        </a>

    </main>

</body>
</html>