<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Reset Password | URL Shortener</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;

            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;

            background: linear-gradient(
                135deg,
                #eef2ff,
                #f8fafc
            );

            color: #111827;
        }

        .container {
            width: min(90%, 420px);

            padding: 40px;

            text-align: center;

            background: rgba(255, 255, 255, 0.92);
            border: 1px solid #e5e7eb;
            border-radius: 16px;

            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
        }

        .icon {
            width: 64px;
            height: 64px;

            margin: 0 auto 24px;

            display: flex;
            justify-content: center;
            align-items: center;

            border-radius: 50%;

            background: #eef2ff;
            color: #4f46e5;

            font-size: 28px;
        }

        .brand {
            margin-bottom: 28px;
        }

        .brand h1 {
            margin: 0 0 10px;

            font-size: 27px;
            font-weight: 700;
        }

        .brand p {
            margin: 0;

            color: #6b7280;
            font-size: 15px;
            line-height: 1.6;
        }

        .form-group {
            margin-bottom: 18px;

            text-align: left;
        }

        label {
            display: block;

            margin-bottom: 8px;

            font-size: 14px;
            font-weight: 600;
        }

        input {
            width: 100%;

            padding: 12px 14px;

            border: 1px solid #d1d5db;
            border-radius: 8px;

            outline: none;

            font-size: 14px;

            transition: 0.2s;
        }

        input:focus {
            border-color: #6366f1;

            box-shadow:
                0 0 0 3px rgba(99, 102, 241, 0.12);
        }

        button {
            width: 100%;

            padding: 12px 18px;

            border: none;
            border-radius: 8px;

            background: #4f46e5;
            color: white;

            font-size: 14px;
            font-weight: 600;

            cursor: pointer;

            transition: 0.2s;
        }

        button:hover {
            background: #4338ca;
            transform: translateY(-1px);
        }

        button:active {
            transform: translateY(0);
        }

        .message {
            margin-bottom: 20px;

            padding: 12px 14px;

            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 8px;

            color: #b91c1c;
            font-size: 14px;
            line-height: 1.5;
        }

        .success {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #15803d;
        }

        .info {
            margin-top: 20px;

            color: #6b7280;
            font-size: 13px;
            line-height: 1.6;
        }

        .footer {
            margin-top: 28px;

            color: #6b7280;
            font-size: 14px;
        }

        .footer a {
            color: #4f46e5;
            text-decoration: none;
            font-weight: 600;
        }

        .footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>

    <main class="container">

        <% if (locals.status === "success") { %>

            <!-- PASSWORD CHANGED -->

            <div class="icon">
                ✓
            </div>

            <div class="brand">
                <h1>Password changed!</h1>

                <p>
                    Your password has been successfully updated.
                    You can now log in using your new password.
                </p>
            </div>

            <a
                href="/user/login"
                style="
                    display: inline-block;
                    width: 100%;
                    padding: 12px 18px;
                    border-radius: 8px;
                    background: #4f46e5;
                    color: white;
                    text-decoration: none;
                    font-size: 14px;
                    font-weight: 600;
                "
            >
                Login
            </a>

        <% } else if (locals.status === "invalid") { %>

            <!-- INVALID / EXPIRED TOKEN -->

            <div class="icon">
                ⚠
            </div>

            <div class="brand">
                <h1>Invalid reset link</h1>

                <p>
                    This password reset link is invalid or has expired.
                    Please request a new reset link.
                </p>
            </div>

            <a
                href="/user/forgot-password"
                style="
                    display: inline-block;
                    width: 100%;
                    padding: 12px 18px;
                    border-radius: 8px;
                    background: #4f46e5;
                    color: white;
                    text-decoration: none;
                    font-size: 14px;
                    font-weight: 600;
                "
            >
                Request a new link
            </a>

        <% } else { %>

            <!-- RESET PASSWORD FORM -->

            <div class="icon">
                🔑
            </div>

            <div class="brand">
                <h1>Reset your password</h1>

                <p>
                    Enter a new password for your account.
                </p>
            </div>

            <% if (locals.message) { %>
                <div class="message">
                    <%= message %>
                </div>
            <% } %>

            <form
                method="POST"
                action="/user/reset-password"
            >

                <% if (locals.token) { %>
                    <input
                        type="hidden"
                        name="token"
                        value="<%= token %>"
                    >
                <% } %>

                <div class="form-group">

                    <label for="password">
                        New password
                    </label>

                    <input
                        id="password"
                        name="password"
                        type="password"
                        placeholder="Enter new password"
                        autocomplete="new-password"
                        required
                    >

                </div>

                <div class="form-group">

                    <label for="confirmPassword">
                        Confirm password
                    </label>

                    <input
                        id="confirmPassword"
                        name="confirmPassword"
                        type="password"
                        placeholder="Confirm new password"
                        autocomplete="new-password"
                        required
                    >

                </div>

                <button type="submit">
                    Reset password
                </button>

            </form>

            <div class="info">
                Make sure your new password is something you haven't
                used before.
            </div>

        <% } %>

    </main>

</body>
</html>