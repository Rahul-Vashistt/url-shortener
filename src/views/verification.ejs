<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <% if (status === "expired") { %>
            Verification Link Expired | URL Shortener
        <% } else if (status === "verified") { %>
            Email Verified | URL Shortener
        <% } else { %>
            Verify Your Email | URL Shortener
        <% } %>
    </title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;

            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;

            background: linear-gradient(
                135deg,
                #eef2ff,
                #f8fafc
            );

            color: #111827;
        }

        .container {
            width: min(90%, 420px);

            padding: 40px;

            text-align: center;

            background: rgba(255, 255, 255, 0.92);
            border: 1px solid #e5e7eb;
            border-radius: 16px;

            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
        }

        .icon {
            width: 64px;
            height: 64px;

            margin: 0 auto 24px;

            display: flex;
            justify-content: center;
            align-items: center;

            border-radius: 50%;

            background: #eef2ff;
            color: #4f46e5;

            font-size: 28px;
        }

        .brand {
            margin-bottom: 24px;
        }

        .brand h1 {
            margin: 0 0 10px;

            font-size: 27px;
            font-weight: 700;
        }

        .brand p {
            margin: 0;

            color: #6b7280;
            font-size: 15px;
            line-height: 1.6;
        }

        .email {
            margin: 20px 0;

            padding: 12px 14px;

            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 8px;

            color: #374151;
            font-size: 14px;
            font-weight: 600;

            word-break: break-word;
        }

        .info {
            margin-top: 20px;

            color: #6b7280;
            font-size: 13px;
            line-height: 1.6;
        }

        .footer {
            margin-top: 28px;

            color: #6b7280;
            font-size: 14px;
        }

        .footer a {
            color: #4f46e5;
            text-decoration: none;
            font-weight: 600;
        }

        .footer a:hover {
            text-decoration: underline;
        }

        .button {
            display: inline-block;

            margin-top: 20px;
            padding: 12px 20px;

            border-radius: 8px;

            background: #4f46e5;
            color: white;

            text-decoration: none;

            font-size: 14px;
            font-weight: 600;

            transition: background 0.2s ease;
        }

        .button:hover {
            background: #4338ca;
        }
    </style>
</head>

<body>

    <main class="container">

        <div class="icon">
            <% if (status === "expired") { %>
                ⏱
            <% } else if (status === "verified") { %>
                ✓
            <% } else { %>
                ✉
            <% } %>
        </div>


        <% if (status === "expired") { %>

            <!-- EXPIRED -->

            <div class="brand">
                <h1>Link expired</h1>

                <p>
                    Your email verification link has expired.
                    Please request a new verification email to continue.
                </p>
            </div>

            <% if (locals.email) { %>
                <div class="email">
                    <%= email %>
                </div>

                <form action="/user/resend-verification" method="POST">
                    <input
                        type="hidden"
                        name="email"
                        value="<%= email %>"
                    >

                    <button type="submit" class="button">
                        Send new verification email
                    </button>
                </form>
            <% } %>

            <div class="info">
                Verification links are valid for 15 minutes.
            </div>


        <% } else if (status === "verified") { %>

            <!-- VERIFIED -->

            <div class="brand">
                <h1>Email verified!</h1>

                <p>
                    Your email address has been successfully verified.
                    You can now log in to your account.
                </p>
            </div>

            <a href="/user/login" class="button">
                Login
            </a>


        <% } else { %>

            <!-- PENDING -->

            <div class="brand">
                <h1>Check your email</h1>

                <p>
                    We've sent a verification link to your email address.
                    Click the link in that email to verify your account.
                </p>
            </div>

            <% if (locals.email) { %>
                <div class="email">
                    <%= locals.email %>
                </div>
            <% } %>

            <div class="info">
                The verification link will expire in 15 minutes.
                <br>
                If you don't see the email, check your spam folder.
            </div>

            <div class="footer">
                Already verified?
                <a href="/user/login">Login</a>
            </div>

        <% } %>

    </main>

</body>
</html>