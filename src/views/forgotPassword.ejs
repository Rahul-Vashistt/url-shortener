<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Forgot Password | URL Shortener</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;

            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;

            background: linear-gradient(
                135deg,
                #eef2ff,
                #f8fafc
            );

            color: #111827;
        }

        .container {
            width: min(90%, 420px);

            padding: 40px;

            text-align: center;

            background: rgba(255, 255, 255, 0.92);
            border: 1px solid #e5e7eb;
            border-radius: 16px;

            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
        }

        .icon {
            width: 64px;
            height: 64px;

            margin: 0 auto 24px;

            display: flex;
            justify-content: center;
            align-items: center;

            border-radius: 50%;

            background: #eef2ff;
            color: #4f46e5;

            font-size: 28px;
        }

        .brand {
            margin-bottom: 28px;
        }

        .brand h1 {
            margin: 0 0 10px;

            font-size: 27px;
            font-weight: 700;
        }

        .brand p {
            margin: 0;

            color: #6b7280;
            font-size: 15px;
            line-height: 1.6;
        }

        .form-group {
            margin-bottom: 18px;

            text-align: left;
        }

        label {
            display: block;

            margin-bottom: 8px;

            font-size: 14px;
            font-weight: 600;
        }

        input {
            width: 100%;

            padding: 12px 14px;

            border: 1px solid #d1d5db;
            border-radius: 8px;

            outline: none;

            font-size: 14px;

            transition: 0.2s;
        }

        input:focus {
            border-color: #6366f1;

            box-shadow:
                0 0 0 3px rgba(99, 102, 241, 0.12);
        }

        button {
            width: 100%;

            padding: 12px 18px;

            border: none;
            border-radius: 8px;

            background: #4f46e5;
            color: white;

            font-size: 14px;
            font-weight: 600;

            cursor: pointer;

            transition: 0.2s;
        }

        button:hover {
            background: #4338ca;
            transform: translateY(-1px);
        }

        button:active {
            transform: translateY(0);
        }

        .message {
            margin-bottom: 20px;

            padding: 12px 14px;

            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 8px;

            color: #b91c1c;
            font-size: 14px;
            line-height: 1.5;
        }

        .email {
            margin: 20px 0;

            padding: 12px 14px;

            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 8px;

            color: #374151;
            font-size: 14px;
            font-weight: 600;

            word-break: break-word;
        }

        .info {
            margin-top: 20px;

            color: #6b7280;
            font-size: 13px;
            line-height: 1.6;
        }

        .footer {
            margin-top: 28px;

            color: #6b7280;
            font-size: 14px;
        }

        .footer a {
            color: #4f46e5;
            text-decoration: none;
            font-weight: 600;
        }

        .footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>

    <main class="container">

        <% if (locals.status === "pending") { %>

            <!-- EMAIL SENT -->

            <div class="icon">
                ✉
            </div>

            <div class="brand">
                <h1>Check your email</h1>

                <p>
                    If an account exists with the email address you
                    provided, we've sent you a password reset link.
                </p>
            </div>

            <% if (locals.email) { %>
                <div class="email">
                    <%= email %>
                </div>
            <% } %>

            <div class="info">
                The reset link will expire in 15 minutes.
                <br>
                If you don't see the email, check your spam folder.
            </div>

            <div class="footer">
                Remember your password?
                <a href="/user/login">Login</a>
            </div>

        <% } else { %>

            <!-- FORGOT PASSWORD FORM -->

            <div class="icon">
                🔑
            </div>

            <div class="brand">
                <h1>Forgot your password?</h1>

                <p>
                    Enter your email address and we'll send you
                    a link to reset your password.
                </p>
            </div>

            <% if (locals.message) { %>
                <div class="message">
                    <%= message %>
                </div>
            <% } %>

            <form
                method="POST"
                action="/user/forgot-password"
            >

                <div class="form-group">

                    <label for="email">
                        Email
                    </label>

                    <input
                        id="email"
                        name="email"
                        type="email"
                        placeholder="you@example.com"
                        autocomplete="email"
                        required
                    >

                </div>

                <button type="submit">
                    Send reset link
                </button>

            </form>

            <div class="footer">
                Remember your password?
                <a href="/user/login">Login</a>
            </div>

        <% } %>

    </main>

</body>
</html>